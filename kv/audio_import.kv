#:kivy 2.2.0
# -----------------------------------------------------------------------
# audio_import.kv -- FAZA 2: real audio file import screen.
# Tap the icon to open the native file picker (MP3 / WAV).
# -----------------------------------------------------------------------

<AudioImportScreen>:
    FloatLayout:
        Image:
            source: app.cfg.MAIN_BACKGROUND
            allow_stretch: True
            keep_ratio: False
            size: self.parent.size
            pos: self.parent.pos

        MDBoxLayout:
            orientation: "vertical"
            size: self.parent.size
            pos: self.parent.pos

            TopBar:
                IconButton:
                    source: app.cfg.icon("back.png")
                    size: dp(38), dp(38)
                    pos_hint: {"center_y": 0.5}
                    on_release: app.go_back()

                MDLabel:
                    text: "U\u010ditaj audio"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.97, 0.98, 1, 1
                    valign: "middle"

                Widget:
                    size_hint_x: None
                    width: dp(38)

            FloatLayout:
                GlassCard:
                    orientation: "vertical"
                    padding: dp(30)
                    spacing: dp(18)
                    size_hint: None, None
                    size: dp(300), dp(320)
                    pos_hint: {"center_x": 0.5, "center_y": 0.55}

                    IconButton:
                        source: root.file_icon
                        size: dp(96), dp(96)
                        pos_hint: {"center_x": 0.5}
                        on_release: root.choose_file()

                    MDLabel:
                        text: "Dodirni ikonu da izabere\u0161 audio fajl (MP3, WAV, M4A...)"
                        font_style: "Body2"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.72, 0.73, 0.88, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(10)

                    MDLabel:
                        text: root.status_text
                        font_style: "Caption"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.70, 0.72, 0.88, 1
                        size_hint_y: None
                        height: self.texture_size[1]
